# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL + PostGIS. The db container creates this user/database on first start.
POSTGRES_USER=foodscape
POSTGRES_PASSWORD=change-me
POSTGRES_DB=foodscape
# "localhost" when running the backend/tests on your machine.
# docker-compose.yml overrides this to "db" (the service name) inside the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache). docker-compose.yml overrides the host to "redis" inside the containers.
REDIS_HOST=localhost
REDIS_PORT=6379

# Census Bureau data API (used by the data pipeline for 2020 block population).
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
