# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL + PostGIS. The db container creates this user/database on first start.
POSTGRES_USER=foodscape
POSTGRES_PASSWORD=change-me
POSTGRES_DB=foodscape
# "localhost" when running the backend/tests on your machine.
# docker-compose.yml overrides this to "db" (the service name) inside the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "prefer" locally; production uses "require" (encrypted connections only)
POSTGRES_SSLMODE=prefer

# Redis (cache). docker-compose.yml overrides the host to "redis" inside the containers.
REDIS_HOST=localhost
REDIS_PORT=6379

# Proxies in front of the API that add the client's IP to X-Forwarded-For (used by the rate
# limiter). 0 when running the backend directly; docker-compose.yml and Azure set it to 1.
TRUSTED_PROXY_HOPS=0

# Census Bureau data API (used by the data pipeline for 2020 block population).
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# CARTO base map tiles (the map's gray background). Free key for non-commercial use:
# https://carto.com/basemaps/apikey. Without it the map works but shows a watermark.
# This key is sent from the browser, so it isn't secret; it's here so it lives in one place.
CARTO_API_KEY=
